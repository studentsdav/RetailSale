# Stage 1: Build Flutter Web application
FROM ghcr.io/cirrusci/flutter:stable AS flutter-builder

WORKDIR /app

# Copy project files
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
RUN flutter build web --release --web-renderer canvaskit

# Stage 2: Node.js backend container serving API + Web UI
FROM node:20-alpine

WORKDIR /app

# Install postgresql-client for pg_dump support
RUN apk add --no-cache postgresql-client

# Copy package definition files from backend directory
COPY backend/package*.json ./

# Install production dependencies
RUN npm ci --only=production || npm install --omit=dev

# Copy backend source code into container
COPY backend/ .

# Copy Flutter Web build output from builder stage to public folder
COPY --from=flutter-builder /app/build/web ./public

# Expose port
EXPOSE 3000

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000

# Start application
CMD ["node", "server.js"]
