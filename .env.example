# ==============================================================================
# RETAILSALE SYSTEM CONFIGURATION (.env.example)
# ==============================================================================

# --- 1. SERVER & RUNTIME ---
PORT=3000
NODE_ENV=development
IS_CLOUD=false

# --- 2. POSTGRESQL DATABASE (Choose either DATABASE_URL or individual parameters) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailsale_db?schema=public
# Or Individual Parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=retailsale_db
DB_SSL=false

# --- 3. AUTHENTICATION & SECURITY ---
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_SECRET=your-aes-256-gcm-secret-key-32-chars-long
BACKUP_SECRET=your-backup-zip-encryption-passphrase

# --- 4. REDIS CACHE & DISTRIBUTED PERFORMANCE (Optional - In-Memory used if omitted) ---
REDIS_URL=rediss://default:password@your-redis-host:6379
# Or:
REDIS_HOST=localhost

# --- 5. CLOUD OBJECT STORAGE / BACKUPS (S3 / Cloudflare R2 / MinIO) ---
S3_BUCKET=retail-pos-backups
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Alternatively for AWS S3:
# AWS_S3_BUCKET=retail-pos-backups
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# Alternatively for Cloudflare R2:
# R2_BUCKET=retail-pos-backups
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- 6. EMAIL SERVICE & OTP DELIVERIES (Resend / Gmail OAuth2 / SMTP) ---
EMAIL_PROVIDER=AUTO
# Resend API (Recommended for Cloud & Render):
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM="Retail POS" <help@famalth.com>
# Gmail OAuth2:
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=1//your-oauth-refresh-token
# Standard SMTP:
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_SECURITY=STARTTLS
EMAIL_SECURE=false
EMAIL_USER=help@famalth.com
EMAIL_PASS=your-smtp-app-password
EMAIL_TIMEOUT=20000

# --- 7. GOOGLE DRIVE & SHEETS SYNC (Optional Cloud Backup) ---
ROOT_FOLDER_ID=your_google_drive_backup_folder_id
SCRIPT_URL=https://script.google.com/macros/s/your-apps-script-id/exec
SHEET_ID=your_google_sheets_spreadsheet_id
